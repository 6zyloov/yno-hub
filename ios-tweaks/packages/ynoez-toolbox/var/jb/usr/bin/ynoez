#!/bin/sh
set -u

VERSION="0.1.0"
cmd="${1:-help}"

header() {
    printf '\nynoez toolbox %s — %s\n' "$VERSION" "$1"
    printf '%s\n' '----------------------------------------'
}

have() { command -v "$1" >/dev/null 2>&1; }

status() {
    header "device status"
    printf 'Model: '
    if have sysctl; then sysctl -n hw.machine 2>/dev/null || echo unknown; else echo unknown; fi
    printf 'Architecture: '; uname -m 2>/dev/null || echo unknown
    printf 'iOS: '
    if have sw_vers; then sw_vers -productVersion 2>/dev/null || echo unknown; else echo unknown; fi
    printf 'Kernel: '; uname -r 2>/dev/null || echo unknown
    printf 'Rootless prefix: /var/jb — '
    [ -d /var/jb ] && echo present || echo missing
    printf 'dpkg: '; have dpkg-query && echo available || echo unavailable
    printf 'Package manager: '
    if [ -x /var/jb/usr/bin/apt ]; then echo apt; elif [ -x /var/jb/usr/bin/dpkg ]; then echo dpkg; else echo not detected; fi
}

storage() {
    header "storage"
    if have df; then
        df -h / /var /var/jb 2>/dev/null || df -h / 2>/dev/null || true
    else
        echo "df is unavailable"
    fi
    echo
    echo "Common data locations (sizes are estimates):"
    for p in /var/mobile/Containers/Data/Application /var/mobile/Library/Caches /var/jb/var/cache/apt/archives; do
        if [ -d "$p" ]; then
            printf '%s: ' "$p"
            if have du; then du -sh "$p" 2>/dev/null | awk '{print $1}' || echo unknown; else echo present; fi
        fi
    done
    echo "No files were changed."
}

packages() {
    header "installed Debian packages"
    if have dpkg-query; then
        dpkg-query -W -f='${binary:Package}\t${Version}\n' 2>/dev/null | sort
    else
        echo "dpkg-query is unavailable"
        return 1
    fi
}

health() {
    header "read-only jailbreak checks"
    for p in /var/jb /var/jb/usr/bin /var/jb/Library/MobileSubstrate/DynamicLibraries /var/jb/usr/lib/TweakInject /var/jb/basebin; do
        if [ -e "$p" ]; then printf '[OK]      %s\n' "$p"; else printf '[MISSING] %s\n' "$p"; fi
    done
    echo
    for p in /var/mobile/Library/Logs/CrashReporter /var/mobile/Library/Logs/DiagnosticReports; do
        if [ -d "$p" ]; then
            count="$(find "$p" -type f 2>/dev/null | wc -l | tr -d ' ')"
            printf 'Reports in %s: %s\n' "$p" "$count"
        fi
    done
    echo
    echo "These are presence checks, not proof that every tweak or injection component is healthy."
}

case "$cmd" in
    status) status ;;
    storage) storage ;;
    packages) packages ;;
    health) health ;;
    help|-h|--help)
        echo "ynoez toolbox $VERSION"
        echo "Usage: ynoez {status|storage|packages|health|help}"
        ;;
    version|-v|--version) echo "ynoez toolbox $VERSION" ;;
    *) echo "Unknown command: $cmd"; echo "Run: ynoez help"; exit 2 ;;
esac
